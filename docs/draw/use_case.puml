@startuml
left to right direction
skinparam packageStyle rectangle

actor "Организатор комнаты" as Organizer
actor "Участник комнаты" as Participant

rectangle "Система MeetMe" {
    usecase "UC-01\nСоздание комнаты" as UC01
    usecase "UC-02\nПодключение к комнате" as UC02
    usecase "UC-03\nНастройка предпочтений" as UC03
    usecase "UC-04\nОценка вариантов\n(свайпы)" as UC04
    usecase "UC-05\nОпределение совпадения\nи вывод результата" as UC05
    usecase "UC-06\nФункция «рулетка»" as UC06
}

' Ассоциации (сплошные линии участия)
Organizer -- UC01
Organizer -- UC03
Organizer -- UC04
Organizer -- UC05
Organizer -- UC06

Participant -- UC02
Participant -- UC03
Participant -- UC04
Participant -- UC05
Participant -- UC06

' Специальные связи (пунктирные стрелки)
UC01 ..> UC03 : <<include>>
UC06 ..> UC05 : <<extend>>

@enduml